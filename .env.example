# Copy this file to .env and fill in real values. Never commit .env itself.
# این فایل را در .env کپی کرده و مقادیر واقعی را وارد کنید. هرگز خود .env را کامیت نکنید.

# Telegram bot token from @BotFather.
BINA_BOT_TOKEN=

# Translation provider API key (Google Translate / DeepL).
BINA_TRANSLATE_API_KEY=

# Which translation provider to use: "google" or "deepl".
BINA_TRANSLATE_PROVIDER=google

# Database connection string (defaults to a local SQLite file if unset).
BINA_DATABASE_URL=sqlite+aiosqlite:///bina.db
